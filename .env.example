# ============================================================
# REVENT Task Workspace — Environment Variables Example
# ============================================================
# Copy this file to .env.local for local development if needed.
# Production environment variables are configured via Cloudflare Workers / Wrangler secrets.

# JWT Secret for Session & Authentication Tokens
JWT_SECRET=your-secure-jwt-secret-here

# Node Environment ('development' or 'production')
NODE_ENV=development

# Cloudflare D1 Database ID (configured in wrangler.toml)
# D1_DATABASE_ID=your-cloudflare-d1-database-id

# Local port (default Next.js: 3000, local test preview: 3005)
# PORT=3000
